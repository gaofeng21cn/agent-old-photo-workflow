{
  "schema_version": "opl-package-app-contribution-adapter.v1",
  "reads": {
    "old-photo.v1#review": {
      "kind": "command",
      "cwd": "package",
      "argv": [
        "python3",
        "./app_contribution.py"
      ],
      "stdin": "request_json",
      "passthrough": true,
      "input_schema": {
        "type": "object",
        "required": [
          "result_path"
        ],
        "properties": {
          "result_path": {
            "type": "string",
            "title": "Pipeline result",
            "description": "Workspace-relative run directory or result.json."
          },
          "expected_revision": {
            "type": "string",
            "title": "Expected result revision"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "actions": {}
}
