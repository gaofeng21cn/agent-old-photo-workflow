{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "agent-old-photo-workflow",
    "version": "0.1.3",
    "intent": "extension",
    "name": {
      "zh-CN": "OPL Photo Restore",
      "en-US": "OPL Photo Restore"
    },
    "summary": {
      "zh-CN": "在本地提取、拉正、修复和上色老照片，并审阅原图与各阶段结果。",
      "en-US": "Extract, rectify, restore, and colorize old photos locally, with reviewable original and stage results."
    },
    "publisher": "gaofeng21cn",
    "license": "Apache-2.0",
    "icon": "assets/branding/agent-old-photo-workflow-logo.png",
    "repository": "https://github.com/gaofeng21cn/agent-old-photo-workflow",
    "routing_summary": {
      "zh-CN": "通过老照片 CLI 处理明确选择的图片；模型与照片保留在本地工作区。",
      "en-US": "Use the Old Photo CLI for explicitly selected images; keep models and photos in the local workspace."
    }
  },
  "dependencies": {
    "opl_base": "^2.0.0"
  },
  "provides": {
    "module_ids": [
      "old-photo.v1"
    ],
    "skills": [
      {
        "id": "agent-old-photo",
        "path": "./skills/agent-old-photo",
        "exposure": "default"
      }
    ],
    "contribution_handler": {
      "kind": "cli",
      "argv": [
        "python3",
        "./app_contribution.py"
      ],
      "transport": "stdin_json_stdout_json"
    }
  },
  "ui": {
    "declarative": {
      "views": [
        {
          "id": "old-photo.status",
          "view_type": "service_status",
          "slot": "settings.section",
          "settings_destination": "services",
          "title": {
            "zh-CN": "老照片运行环境",
            "en-US": "Old-photo runtime"
          },
          "data_ref": "old-photo.v1#status",
          "sort_order": 690
        },
        {
          "id": "old-photo.review",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "services",
          "title": {
            "zh-CN": "老照片阶段对照",
            "en-US": "Old-photo stage comparison"
          },
          "data_ref": "old-photo.v1#review",
          "sort_order": 700
        }
      ]
    }
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/agent-old-photo-workflow",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": false
    }
  }
}
